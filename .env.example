# Frontend-safe values. These are embedded in the Vite bundle.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SUPPORT_EMAIL=support@example.com
# Leave unset in production to use same-origin /api functions.
VITE_API_URL=http://localhost:8787

# Local API adapter and canonical application URL.
API_PORT=8787
APP_URL=http://localhost:5173

# Server-only values. Never prefix these with VITE_.
CLERK_SECRET_KEY=
# Comma-separated exact origins allowed to present Clerk session tokens.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_INDIVIDUAL_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Managed Postgres connection string, such as a pooled Neon URL.
DATABASE_URL=
